# SQLite path is resolved relative to api/prisma/schema.prisma when relative.
# Local dev (SQLite) — resolves to api/db/custom.db:
DATABASE_URL=file:../db/custom.db
# Default country dial code used to normalize 10-digit phone numbers:
DEFAULT_COUNTRY_CODE=91

# --- Supabase Postgres (production target) ----------------------------------
# REAL values live ONLY in .env (gitignored) — never in this file, never in git.
# Populate in .env with the actual pooler connection strings from Supabase.
# Placeholder format shown here (no real host/credentials):
#
# Transaction pooler (pgbouncer, port 6543) — app runtime connection
# (becomes DATABASE_URL when the API migrates to Postgres in prod):
SUPABASE_TRANSACTION_POOLER_URL=postgresql://<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:6543/postgres
#
# Session pooler (port 5432) — direct connection for schema changes
# (becomes DIRECT_URL for `prisma db push` / migrations in prod):
SUPABASE_SESSION_POOLER_URL=postgresql://<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:5432/postgres
